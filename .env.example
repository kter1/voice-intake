# voice-intake - environment configuration
# Copy to .env and fill in values.  Never commit .env to git.
#
# Mock flags
# Set to false and supply the real keys below to use production services.
MOCK_LLM=true
MOCK_ASR=true
MOCK_ELIGIBILITY=true
MOCK_PATIENT_LOOKUP=true
MOCK_TWILIO_VALIDATE=true
# Routes browser /turn calls through the appointment-scheduling DemoRouter.
# `make dev` overrides this to true.  Set false to use MockLLM or a real LLM.
DEMO_ROUTER=false

# LLM - provider selection
# Use `remote` for a cloud AI endpoint or `ollama` for a local Ollama server.
LLM_PROVIDER=remote
# Optional prompt profile. Leave as default for normal local use.
LLM_PROMPT_PROFILE=default

# Remote AI endpoint (required when MOCK_LLM=false and LLM_PROVIDER=remote)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=8.0
# Worst-case dead air per turn is (LLM_MAX_RETRIES + 1) x LLM_TIMEOUT_SECONDS
# plus backoff delays. Use LLM_MAX_RETRIES=1 for phone-pace demos.
LLM_MAX_RETRIES=3
# Chat-completions REST path. Default works for OpenAI, Groq, Cerebras, and most providers.
LLM_CHAT_COMPLETIONS_PATH=/v1/chat/completions
#
# Gemini OpenAI-compatible example (verify Free Tier / no billing before use):
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_CHAT_COMPLETIONS_PATH=/chat/completions
# LLM_MODEL=gemini-2.5-flash-lite

# Ollama configuration (used when MOCK_LLM=false and LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# ASR - Deepgram
# Required when MOCK_ASR=false
DEEPGRAM_API_KEY=

# Database
# SQLite (default for local dev):
DATABASE_URL=sqlite:///./voice_intake.db
# PostgreSQL (production):
# DATABASE_URL=postgresql://user:password@host:5432/voice_intake

# Knowledge / RAG
CHROMA_PATH=:memory:
# Persistent path for production:
# CHROMA_PATH=./chroma_data

# RAG seed
# When set and MOCK_RAG=false, seeds this directory into ChromaDB at startup.
# Use `make demo` - it sets this automatically to data/rag_seed/demo_practice.
RAG_SEED_PATH=

# Patient lookup
# Path to CSV file when MOCK_PATIENT_LOOKUP=true (optional):
# PATIENT_LOOKUP_CSV=./data/patients.csv

# Telephony - Twilio
# Required for inbound phone calls.  Needs a public HTTPS URL (ngrok/Cloudflare).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
HUMAN_AGENT_QUEUE=human-agent-queue

# Customer-pilot auth / integrity
# Blank API_KEY disables HTTP auth for local development.
API_KEY=
# Short-lived Twilio media-stream token signing secret.
STREAM_AUTH_SECRET=
# Full-payload audit-chain HMAC secret.
AUDIT_HMAC_SECRET=

# Dashboard auth forwarding
# Build-time key forwarded by the internal dashboard to the API.
# This is only appropriate for a trusted internal operator dashboard, not a public browser app.
VITE_API_KEY=

# CORS
# Space-separated list of extra allowed origins beyond localhost:5173
# CORS_ORIGINS=https://your-app.com

# Debug
DEBUG=false
LOG_LEVEL=INFO
